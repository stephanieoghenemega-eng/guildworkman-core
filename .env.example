# Copy to .env locally and fill in real values. Never commit a populated .env.
# Spring Boot doesn't read .env files itself -- use this with `docker run
# --env-file .env`, `export $(grep -v '^#' .env | xargs)`, or your IDE's
# run-configuration env-var support.

DATABASE_URL=jdbc:postgresql://localhost:5432/service
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DDL_AUTO=update

# Brevo (Sendinblue) transactional email
MAIL_API_KEY=
MAIL_API_URL=https://api.brevo.com/v3/smtp/email

# Cloudinary media uploads
CLOUDINARY_API_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack payments
PAYSTACK_SECRET_KEY=
PAYSTACK_VERIFY_URL=https://api.paystack.co/transaction/verify
PAYSTACK_INITIATE_URL=https://api.paystack.co/transaction/initialize

H2_CONSOLE_ENABLED=false
